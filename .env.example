DATABASE_URL=postgres://postgres:postgres@localhost:5432/od_signing
APP_URL=http://localhost:3000
STORAGE_ROOT=.data/private-documents
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate an Ed25519 PKCS8 key and base64 encode its PEM for local manifest/audit signing.
SIGNING_PRIVATE_KEY_B64=
SIGNING_PUBLIC_KEY_B64=
NODE_ENV=development
